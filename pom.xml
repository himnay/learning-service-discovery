<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.org.llm</groupId>
        <artifactId>super-pom</artifactId>
        <version>1.2.1</version>
    </parent>

    <groupId>com.learning</groupId>
    <artifactId>learning-spring-cloud</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>learning-spring-cloud</name>
    <description>Eureka service discovery demo: 3 microservices registering to a Eureka registry</description>

    <modules>
        <module>eureka-server-1</module>
        <module>eureka-server-2</module>
        <module>admin-server</module>
        <module>user-service</module>
        <module>order-service</module>
        <module>product-service</module>
        <module>gateway-service</module>
        <!-- Own Spring Boot 3.5 build, no parent: see zipkin-server/pom.xml -->
        <module>zipkin-server</module>
    </modules>

    <build>
        <plugins>
            <!-- Executions/config come from spring-boot-starter-parent's pluginManagement: writes
                 META-INF/sbom/application.cdx.json, served by /actuator/sbom (SBA "SBOM" view). -->
            <plugin>
                <groupId>org.cyclonedx</groupId>
                <artifactId>cyclonedx-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
